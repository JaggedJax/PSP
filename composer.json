{
	"name": "jaggedjax/psp",
	"description": "PHP Starter Project - Lightweight common utilities to help you get going",
	"type": "library",
	"require": {
		"php": "^8.5",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-mbstring": "*",
		"ext-pdo": "*",
		"ext-pdo_mysql": "*",
		"amphp/amp": "^3.1",
		"amphp/process": "^2.0",
		"monolog/monolog": "^3.9",
		"open-telemetry/api": "^1.10"
	},
	"require-dev": {
		"antecedent/patchwork": "^2.2",
		"friendsofphp/php-cs-fixer": "^3.84",
		"phpseclib/phpseclib": "^3.0",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^12.1"
	},
	"suggest": {
		"ext-ftp": "Needed by PSP\\Files\\Ftp",
		"ext-memcached": "Enables PSP\\Cache\\MemCache",
		"ext-pcntl": "Lets PSP\\Process\\Scheduler stop running jobs on SIGTERM/SIGINT",
		"ext-posix": "Faster process checks in PSP\\Process\\Lock",
		"phpseclib/phpseclib": "Needed by PSP\\Files\\Sftp"
	},
	"autoload": {
		"psr-4": {
			"PSP\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PSP\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"test": "php -d auto_prepend_file=vendor/antecedent/patchwork/Patchwork.php vendor/bin/phpunit",
		"stan": "phpstan analyse --memory-limit=1G",
		"cs": "php-cs-fixer fix --dry-run --diff"
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true,
			"tbachert/spi": true
		}
	}
}
